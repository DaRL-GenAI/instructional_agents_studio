{
  "name": "instructional-agents",
  "version": "0.1.2",
  "description": "Instructional Agents Studio as a local app: each course is a folder (a git repository) edited in the browser, with Claude Code, Codex or a built-in agent.",
  "keywords": [
    "education",
    "course-design",
    "slides",
    "agents",
    "claude-code",
    "codex",
    "onlyoffice"
  ],
  "homepage": "https://github.com/DaRL-GenAI/instructional_agents_studio#readme",
  "bugs": {
    "url": "https://github.com/DaRL-GenAI/instructional_agents_studio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaRL-GenAI/instructional_agents_studio.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "instructional-agents": "bin/cli.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "bin",
    "server",
    "js",
    "css",
    "assets",
    "index.html",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/cli.mjs",
    "test": "node --test test/",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "isomorphic-git": "^1.44.10",
    "ws": "^8.22.1"
  },
  "optionalDependencies": {
    "instructional-agents-editor": "^0.1.1",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "codemirror": "^6.0.2",
    "docx": "^9.15.1",
    "esbuild": "^0.25.12",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^12.0.2",
    "mp4-muxer": "5.2.2",
    "pdfjs-dist": "3.11.174",
    "playwright-core": "^1.64.1",
    "pptxgenjs": "3.12.0"
  }
}
